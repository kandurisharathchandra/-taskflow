# Backend
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/taskflow

# Separate database used by the backend test suite (it is wiped between tests)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/taskflow_test

# Frontend (optional). Leave unset in development: Vite proxies /api to the backend.
# Set it at build time when the API is served from a different origin.
# VITE_API_URL=https://api.example.com/api
